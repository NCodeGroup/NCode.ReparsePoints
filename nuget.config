<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources: nuget.org only, with every source a user or machine configuration adds cleared, so restore resolves the same packages on every PC and in CI. Add a private feed here, with packageSourceMapping when there are several. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
