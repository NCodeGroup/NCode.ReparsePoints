# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,xml,props,targets,resx,config,toml}]
indent_size = 2

[*.{htm,html,cshtml,css,scss,js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[*.cs]
csharp_wrap_parameters_style = chop_if_long
csharp_wrap_before_declaration_lpar = false
csharp_wrap_after_declaration_lpar = true
csharp_wrap_before_declaration_rpar = true

csharp_wrap_arguments_style = chop_if_long
csharp_wrap_before_invocation_lpar = false
csharp_wrap_after_invocation_lpar = true
csharp_wrap_before_invocation_rpar = true

csharp_place_method_attribute_on_same_line = never
csharp_place_constructor_initializer_on_same_line = false
csharp_wrap_before_first_type_parameter_constraint = true
csharp_wrap_multiple_type_parameter_constraints_style = chop_always

# The header each new C# file starts with: the copyright line, and an SPDX line for the license answered. Visual Studio and Rider add it, and IDE0073 offers the fix. A suggestion, so files without it still build. Roslyn ends a value at the first ; or #, so the header holds neither.
file_header_template = Copyright © NCode Group\nSPDX-License-Identifier: Apache-2.0
dotnet_diagnostic.IDE0073.severity = suggestion

# EF Core migrations are scaffolded by dotnet ef, not written by hand: the analyzers treat them as generated code.
[**/Migrations/**.cs]
generated_code = true

# The Win32 access-right enums list the SDK's documented aliases, such as FileReadData and FileListDirectory (both 0x1), under their own names to match the Win32 headers.
[src/NCode.ReparsePoints/Win32/Enums.cs]
dotnet_diagnostic.CA1069.severity = none

# The DSC resource's assembly and its MOF schema are named NCode_cReparsePoints, and PowerShell finds the resource by that name.
[src/NCode_cReparsePoints/**.cs]
dotnet_diagnostic.CA1707.severity = none
