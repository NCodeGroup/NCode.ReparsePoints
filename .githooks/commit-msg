#!/usr/bin/env sh
#
# commit-msg - strip AI agent attribution from the commit message.
#
# A commit records the people who wrote it. AI agents add their own attribution,
# whichever agent or model it is (Copilot, Claude, Codex, Cursor, Devin, Gemini,
# Grok, GitLab Duo, aider, a local model or any other): a `Co-authored-by:`
# trailer that names the agent or uses its address, a session trailer such as
# `Claude-Session:`, `Agent-Logs-Url:` or `Amp-Thread-ID:`, a `Made-with:`,
# `Assisted-by:` or `Generated-by:` trailer that names an AI tool, a
# "Generated with" or "Generated by" line that names one, or a line that holds
# only a link to an agent's session or task. The repository host counts a
# co-author trailer as a contributor, and only rewriting published history
# removes it again. Claude Code's `attribution` setting and VS Code's
# `git.addAICoAuthor` setting already turn these off; this hook removes any
# that slip through, whichever tool wrote the commit. A person's trailer stays:
# a name an agent shares with people, such as Claude or Devin, counts only with
# an agent's address or a model's name.
# It needs grep, and refuses every commit when grep is missing, since it can't
# tell then whether the message has agent attribution.
#
# This file comes from the project template, and template updates replace it.
# Git runs it once it is enabled in a clone; New-Project.ps1 and
# Update-Project.ps1 do that:
#     git config core.hooksPath .githooks
# A clone that uses pre-commit runs it as a local hook instead, with
# `entry: .githooks/commit-msg`, `language: script` and
# `stages: [commit-msg]`; Update-Project.ps1 prints the hook to add.
# env finds sh on PATH: pre-commit on Windows takes a shebang's path
# literally, and Windows has no /bin/sh.

set -eu

msg_file="$1"

# The same patterns as .template/Test-CommitAttribution.ps1, character for character, so the hook strips every
# line the check fails; they use only regex syntax POSIX ERE and .NET share.
# The C locale reads each byte as a character, so an emoji before a phrase matches [^a-zA-Z0-9] whatever locale the user has; a UTF-8 locale reads it differently on some platforms.
agent_bot='(claude|copilot-swe-agent|anthropic-code-agent|chatgpt-codex-connector|cursor|devin-ai-integration|google-labs-jules|gemini-code-assist|grok-by-xai|amazon-q-developer|kiro-agent|jetbrains-junie|windsurf-bot|factory-droid|kiloconnect|kilo-code-bot|augmentcode|opencode-agent)\[bot\]'
agent_login="(copilot|claude|gemini-cli|$agent_bot)"
agent_address='([^>]*@anthropic\.com|(noreply|codex)@openai\.com|(cursoragent|noreply)@cursor\.com|aider@aider\.chat|(amp|noreply)@ampcode\.com|noreply@continue\.dev|crush@charm\.land|qwen-coder@alibabacloud\.com|openhands@all-hands\.dev|(agent|oz-agent)@warp\.dev|(noreply|agent)@augmentcode\.com|noreply@kiro\.dev|noreply@kilo\.ai|agent@kilocode\.ai|noreply@cline\.bot|noreply@codeium\.com|cascade@windsurf\.ai|noreply@tabnine\.com|junie@(jetbrains\.com|air\.dev)|copilot@github\.com|noreply@x\.ai|noreply@pi\.dev|noreply@cognition\.ai|noreply@google\.com|noreply@antigravity\.google|codewhisperer@amazon\.com|gitlab-duo@[^>]*|ai@local)'
agent_email="^ *co-authored-by:.*<(([^>]*[+])?${agent_login}@users\.noreply\.github\.com|${agent_address})>"
agent_coauthor='^ *co-authored-by: *(github +)?(copilot[^<]*|codex|chatgpt|openhands|tabnine( cli)?|windsurf( cascade)?|codeium|aider( \([^)]*\))?|claude (code|opus|sonnet|haiku)[^<]*|grok [0-9][^<]*|gpt[- ]?[0-9][^<]*|cursor agent|devin ai|[^<]* via cursor) *<'
agent_trailer='^ *(claude-session|agent-logs-url|amp-thread-id):'
tool_trailer='^ *(made-with|assisted-by|generated-by): *(claude (code|opus|sonnet|haiku)|(claude|devin|jules|kiro|junie|cline|amp|kilo|augment):|(anthropic|(github +)?copilot|codex|chatgpt|openai|gpt-?[0-9][a-z0-9.]*|cursor|crush|gemini|grok|aider|windsurf|codeium|tabnine|qwen[0-9.]*|openhands|opencode|kilo code|augment code|amazon q|codewhisperer|gitlab duo|ollama|deepseek)([^a-zA-Z0-9]|$))'
generated='^[^a-zA-Z0-9]*((this )?(pr|pull request|mr|merge request|commit|change|issue|comment) (was )?)?(generated|created|written|made|co-authored|authored|built)( automatically)? +(with|by|using|via) +(\[(claude|devin|jules|kiro|junie|continue|amp)\]|\[?(claude (code|opus|sonnet|haiku)|claude\.ai|anthropic|(github +)?copilot|codex|chatgpt|openai|gpt-?[0-9][a-z0-9.]*|cursor|gemini|antigravity|grok|aider|crush|codeium|windsurf|cline|tabnine|qwen[0-9.]*|deepseek|openhands|opencode|amazon q|codewhisperer|(amazon )?bedrock|gitlab duo|kilo code|ollama|lm studio|jules for task|(an )?ai( agent| model| tool| assistant)?)([^a-zA-Z0-9]|$))'
session_link='^[^a-zA-Z0-9]*([a-z][a-z ]{0,39}: *)?(https?://)?(claude\.ai/code/session_|chatgpt\.com/codex/tasks/|chatgpt\.com/s/cd_|cursor\.com/agents/|cursor\.com/background-agent|app\.devin\.ai/sessions/|jules\.google\.com/task/|ampcode\.com/threads/|app\.all-hands\.dev/conversations/|opencode\.ai/s/)[^ ]* *$'

status=0
LC_ALL=C grep -qiE -e "$agent_email" -e "$agent_coauthor" -e "$agent_trailer" -e "$tool_trailer" -e "$generated" -e "$session_link" "$msg_file" || status=$?
case $status in
    0) ;;
    1) exit 0 ;;
    *)
        echo "commit-msg: can't check the commit message for AI agent attribution, because grep is missing or failed. Put grep on PATH and commit again." >&2
        exit 1
        ;;
esac

# `git stripspace` collapses the blank lines a removed trailer leaves behind,
# as git's own message cleanup does; comment lines stay for the editor flow.
stripped="$msg_file.no-agent-attribution"
LC_ALL=C grep -viE -e "$agent_email" -e "$agent_coauthor" -e "$agent_trailer" -e "$tool_trailer" -e "$generated" -e "$session_link" "$msg_file" | git stripspace >"$stripped"
mv "$stripped" "$msg_file"

echo "commit-msg: removed AI agent attribution from the commit message." >&2
